function origenHTML(){
  const filas = ORIGENES.map(o=>{
    const todos = db.alumnos.filter(a=>a.origen===o);
    const matric = todos.filter(a=>a.estado==='activo'||a.estado==='baja');
    const ingresos = todos.filter(a=>a.estado==='activo').reduce((s,a)=>s+a.cuota,0);
    return {o, total:todos.length, matric:matric.length, ingresos};
  }).sort((x,y)=>y.total-x.total);
  const max = Math.max(...filas.map(f=>f.total),1);
