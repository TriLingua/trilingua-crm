/* ================== Lógica de negocio ================== */
const alumno = id => db.alumnos.find(a=>a.id===id);
const contactosDe = id => db.contactos.filter(c=>c.alumnoId===id).sort((a,b)=>b.fecha.localeCompare(a.fecha));
const pagosDe = id => db.pagos.filter(p=>p.alumnoId===id).sort((a,b)=>b.mes.localeCompare(a.mes));
const ultimoContacto = id => contactosDe(id).find(c=>c.fecha<=hoyISO);
const ultimaPrueba = id => contactosDe(id).find(c=>c.tipo==='Clase de prueba');

function tareas(){
  const t = [], mesAct = mesKey(0);
  db.pagos.filter(p=>p.estado==='pendiente').forEach(p=>{
    const a = alumno(p.alumnoId); if(!a) return;
    const mesTxt = fmtMes(p.mes).split(' ')[0].toLowerCase();
    t.push({id:'pago-'+p.id, tipo:'Cobro', prio:p.mes<mesAct?0:2, a, texto:'Recibo de '+fmtMes(p.mes).toLowerCase()+' sin cobrar ('+eur(p.importe)+')', accion:'pagar', pagoId:p.id,
      msg:`Hola ${nombrePila(a)}, te escribimos de Trilingua. Te recordamos que el recibo de ${mesTxt} (${eur(p.importe)}) está pendiente. Puedes pagarlo en recepción o por Bizum. ¡Gracias!`});
  });
  db.alumnos.forEach(a=>{
    if(a.estado==='interesado'){
      const pr = ultimaPrueba(a.id);
      if(pr){
        const d = diasDesde(pr.fecha);
        const despues = db.contactos.some(c=>c.alumnoId===a.id && c.fecha>pr.fecha);
        if(d>=3 && !despues) t.push({id:'prueba-'+a.id+'-'+pr.fecha, tipo:'Seguimiento', prio:1, a, texto:'Hizo la clase de prueba hace '+d+' días y no se ha matriculado. Llamar', accion:'hecho',
          msg:`Hola ${nombrePila(a)}, soy de Trilingua. ¿Qué tal te fue la clase de prueba de ${a.idioma.toLowerCase()}? Si te encajó, te guardamos plaza en el grupo de ${a.horario}.`});
        else if(d<=0 && d>=-7) t.push({id:'agenda-'+a.id+'-'+pr.fecha, tipo:'Agenda', prio:4, a, texto: d===0?'Clase de prueba hoy':'Clase de prueba en '+(-d)+(d===-1?' día':' días'), accion:null,
          msg:`Hola ${nombrePila(a)}, te recordamos tu clase de prueba de ${a.idioma.toLowerCase()} en Trilingua el ${fmtFecha(pr.fecha)}. ¡Te esperamos!`});
      }
    }
    if(a.estado==='activo'){
      if(a.faltas>=3) t.push({id:'faltas-'+a.id+'-'+a.faltas, tipo:'Riesgo', prio:1, a, texto:a.faltas+' faltas seguidas. Riesgo de baja: llamar', accion:'hecho',
        msg:`Hola ${nombrePila(a)}, te hemos echado de menos en las últimas clases de ${a.idioma.toLowerCase()}. ¿Va todo bien? Si te viene mejor otro horario, te buscamos hueco.`});
      if(a.examen && a.examen.fecha){
        const d = -diasDesde(a.examen.fecha);
        if(d>=0 && d<=30) t.push({id:'examen-'+a.id+'-'+a.examen.fecha, tipo:'Examen', prio:3, a, texto:a.examen.nombre+' en '+d+' días: confirmar inscripción y hacer simulacro', accion:'hecho',
          msg:`Hola ${nombrePila(a)}, quedan ${d} días para el ${a.examen.nombre}. ¿Has hecho ya la inscripción? Esta semana hacemos un simulacro en clase.`});
      }
    }
  });
  return t.filter(x=>!db.hechas.includes(x.id)).sort((x,y)=>x.prio-y.prio);
}

function indicadores(){
  const activos = db.alumnos.filter(a=>a.estado==='activo');
  const porIdioma = IDIOMAS.map(i=>[i, activos.filter(a=>a.idioma===i).length]);
  const mes = mesKey(0);
  const pagosMes = db.pagos.filter(p=>p.mes===mes);
  const previsto = pagosMes.reduce((s,p)=>s+p.importe,0);
  const cobrado = pagosMes.filter(p=>p.estado==='pagado').reduce((s,p)=>s+p.importe,0);
  // Conversión: alumnos con clase de prueba (ya hecha) en los últimos 90 días
  const conPrueba = new Set(db.contactos.filter(c=>c.tipo==='Clase de prueba' && diasDesde(c.fecha)>=0 && diasDesde(c.fecha)<=90).map(c=>c.alumnoId));
  const pruebas = [...conPrueba].map(alumno).filter(Boolean);
  const convertidos = pruebas.filter(a=>a.estado==='activo'||a.estado==='baja').length;
  const bajas = db.alumnos.filter(a=>a.estado==='baja' && a.fechaBaja && diasDesde(a.fechaBaja)<=90);
  const historico = [-2,-1,0].map(m=>{ const k=mesKey(m); return [k, db.pagos.filter(p=>p.mes===k && p.estado==='pagado').reduce((s,p)=>s+p.importe,0)]; });
  return {activos:activos.length, porIdioma, previsto, cobrado, pruebas:pruebas.length, convertidos, bajas, historico};
}

