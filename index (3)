  body{margin:0;font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--ink);font-size:15px;line-height:1.45}
  header{background:var(--card);border-bottom:1px solid var(--line);padding:14px 24px;display:flex;align-items:center;gap:24px;flex-wrap:wrap;position:sticky;top:0;z-index:5}
  .marca{font-weight:700;font-size:18px}
  .marca small{display:block;font-weight:400;font-size:12px;color:var(--muted)}
  nav{display:flex;gap:6px;flex:1}
  nav button{background:none;border:1px solid transparent;padding:8px 14px;border-radius:8px;font:inherit;cursor:pointer;color:var(--muted)}
  nav button.activo{background:var(--accent-soft);color:var(--accent);font-weight:600}
  nav button:hover{color:var(--ink)}
  .hoy{color:var(--muted);font-size:13px}
  main{max-width:1180px;margin:0 auto;padding:24px}
  h2{font-size:18px;margin:0 0 12px}
  h3{font-size:15px;margin:0 0 10px}
  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-bottom:20px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}
  .kpi .etq{color:var(--muted);font-size:13px}
  .kpi .valor{font-size:28px;font-weight:700;margin:4px 0}
  .kpi .det{font-size:13px;color:var(--muted)}
  .barra{height:8px;background:var(--line);border-radius:4px;overflow:hidden;margin-top:8px}
  .barra span{display:block;height:100%;background:var(--accent)}
  .cols{display:grid;grid-template-columns:3fr 2fr;gap:16px}
  @media(max-width:860px){.cols{grid-template-columns:1fr}}
  .tarea{display:flex;gap:12px;align-items:center;padding:10px 0;border-top:1px solid var(--line)}
  .tarea:first-of-type{border-top:none}
  .tarea .info{flex:1}
  .tarea .nom{font-weight:600;cursor:pointer}
  .tarea .nom:hover{text-decoration:underline}
  .tarea .txt{font-size:13px;color:var(--muted)}
  .chip{display:inline-block;font-size:11px;font-weight:600;padding:2px 8px;border-radius:10px;white-space:nowrap}
  .c-Cobro{background:var(--bad-soft);color:var(--bad)}
  .c-Riesgo{background:var(--warn-soft);color:var(--warn)}
  .c-Seguimiento{background:var(--accent-soft);color:var(--accent)}
  .c-Examen{background:#ece8f6;color:#5b3f99}
  .c-Agenda{background:#eef0f3;color:var(--muted)}
  .e-activo{background:var(--ok-soft);color:var(--ok)}
  .e-interesado{background:var(--accent-soft);color:var(--accent)}
  .e-baja{background:#eef0f3;color:var(--muted)}
  .e-perdido{background:#f3ecec;color:#8a5a5a}
  .i-Inglés{color:var(--en)} .i-Francés{color:var(--fr)} .i-Italiano{color:var(--it)}
