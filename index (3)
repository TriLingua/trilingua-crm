  <div class="tabla-wrap"><table>
    <thead><tr><th>Nombre</th><th>Idioma</th><th>Modalidad · horario</th><th>Cuota</th><th>Estado</th><th>Último contacto</th></tr></thead>
    <tbody>${lista.map(a=>{ const u=ultimoContacto(a.id); const deuda=db.pagos.some(p=>p.alumnoId===a.id&&p.estado==='pendiente');
      return `<tr onclick="abrirFicha(${a.id})">
      <td><b>${esc(a.nombre)}</b>${deuda?' <span class="chip c-Cobro">Recibo pendiente</span>':''}${a.estado==='activo'&&a.faltas>=3?' <span class="chip c-Riesgo">Riesgo</span>':''}<br><span style="color:var(--muted);font-size:13px">${esc(a.telefono)}</span></td>
      <td class="i-${a.idioma}">${bandera(a.idioma)}${a.idioma} ${a.nivel}</td><td>${a.modalidad} · ${esc(a.horario)}</td><td>${eur(a.cuota)}</td>
      <td><span class="chip e-${a.estado}">${a.estado}</span></td>
      <td>${u?fmtFecha(u.fecha)+'<br><span style="color:var(--muted);font-size:13px">'+u.tipo+'</span>':''}</td></tr>`;}).join('')
      || '<tr><td colspan="6" class="vacio">No hay alumnos con esos filtros.</td></tr>'}</tbody>
  </table></div>`;
}

function camposAlumno(a, pref){
  const sel = (id,arr,val) => `<select id="${pref}${id}">${arr.map(x=>`<option ${x===val?'selected':''}>${x}</option>`).join('')}</select>`;
  return `<div class="grid">
    <label>Nombre y apellidos<input id="${pref}nombre" value="${esc(a.nombre)}" required></label>
    <label>Teléfono<input id="${pref}telefono" value="${esc(a.telefono)}"></label>
    <label>Email<input id="${pref}email" value="${esc(a.email)}"></label>
    <label>Idioma${sel('idioma',IDIOMAS,a.idioma)}</label>
    <label>Nivel${sel('nivel',NIVELES,a.nivel)}</label>
    <label>Modalidad${sel('modalidad',MODALIDADES,a.modalidad)}</label>
    <label>Grupo u horario<input id="${pref}horario" value="${esc(a.horario)}" placeholder="L y X 19:30"></label>
    <label>Cuota mensual (€)<input id="${pref}cuota" type="number" min="0" value="${a.cuota}"></label>
    <label>Objetivo${sel('objetivo',OBJETIVOS,a.objetivo)}</label>
    <label>Cómo nos conoció${sel('origen',ORIGENES,a.origen)}</label>
    <label>Faltas seguidas<input id="${pref}faltas" type="number" min="0" value="${a.faltas}"></label>
    <label>Examen oficial<input id="${pref}exnombre" value="${esc(a.examen.nombre)}" placeholder="B2 First, DELF B1, CILS..."></label>
    <label>Fecha del examen<input id="${pref}exfecha" type="date" value="${a.examen.fecha}"></label>
    <label class="ancho">Notas<textarea id="${pref}notas" rows="2">${esc(a.notas)}</textarea></label>
  </div>`;
}
function leerCampos(pref){
  const v = id => document.getElementById(pref+id).value;
  return {nombre:v('nombre').trim(), telefono:v('telefono').trim(), email:v('email').trim(), idioma:v('idioma'), nivel:v('nivel'),
    modalidad:v('modalidad'), horario:v('horario').trim(), cuota:Number(v('cuota'))||0, objetivo:v('objetivo'), origen:v('origen'),
    faltas:Number(v('faltas'))||0, examen:{nombre:v('exnombre').trim(), fecha:v('exfecha')}, notas:v('notas').trim()};
}

function vistaNuevo(){
  const vacio = {nombre:'',telefono:'',email:'',idioma:'Inglés',nivel:'A2',modalidad:'Grupo',horario:'',cuota:85,objetivo:'Trabajo',origen:'Web',faltas:0,examen:{nombre:'',fecha:''},notas:''};
  return `<div class="card" style="max-width:880px">
    <h2>Nuevo alumno</h2>
    ${camposAlumno(vacio,'n-')}
    <div class="grid" style="margin-top:12px">
      <label>Estado<select id="n-estado"><option value="interesado">Interesado (aún no matriculado)</option><option value="activo">Activo (matriculado hoy)</option></select></label>
      <label>Clase de prueba (opcional)<input id="n-prueba" type="date"></label>
    </div>
    <div class="fila-acc"><button class="btn" onclick="crearAlumno()">Guardar alumno</button></div>
  </div>`;
}

function crearAlumno(){
  const d = leerCampos('n-');
  if(!d.nombre){ aviso('Falta el nombre'); return; }
  const estado = document.getElementById('n-estado').value;
  const prueba = document.getElementById('n-prueba').value;
  const a = Object.assign({id:db.seq++, estado, alta: estado==='activo'?hoyISO:'', fechaBaja:'', motivoBaja:''}, d);
  db.alumnos.push(a);
  db.contactos.push({id:db.seq++, alumnoId:a.id, fecha:hoyISO, tipo:'Visita', nota:'Alta en el CRM'});
  if(prueba) db.contactos.push({id:db.seq++, alumnoId:a.id, fecha:prueba, tipo:'Clase de prueba', nota: prueba>hoyISO?'Clase de prueba programada':'Clase de prueba'});
  if(estado==='activo') db.pagos.push({id:db.seq++, alumnoId:a.id, mes:mesKey(0), importe:a.cuota, estado:'pendiente'});
  guardar(); aviso('Alumno guardado'); ui.vista='alumnos'; render(); abrirFicha(a.id);
}

/* ================== Ficha ================== */
function abrirFicha(id){ ui.fichaId=id; pintarFicha(); document.getElementById('modal').classList.add('abierto'); }
function cerrarFicha(){ ui.fichaId=null; document.getElementById('modal').classList.remove('abierto'); }
document.addEventListener('keydown', e=>{ if(e.key==='Escape') cerrarFicha(); });

function pintarFicha(){
  const a = alumno(ui.fichaId); if(!a) return;
  const pagos = pagosDe(a.id), cs = contactosDe(a.id);
  const deuda = pagos.filter(p=>p.estado==='pendiente').reduce((s,p)=>s+p.importe,0);
  let acciones = '';
  if(a.estado==='interesado') acciones = `<button class="btn" onclick="matricular(${a.id})">Matricular hoy</button><input id="motivo" placeholder="Motivo si no se matricula" style="flex:1;min-width:200px"><button class="btn sec" onclick="marcarPerdido(${a.id})">Marcar como perdido</button>`;
  if(a.estado==='perdido') acciones = `<span style="color:var(--muted);font-size:14px">No se matriculó (${fmtFecha(a.fechaBaja)}): ${esc(a.motivoBaja)}</span><button class="btn" onclick="recuperar(${a.id})">Volver a interesado</button>`;
  if(a.estado==='activo') acciones = `<input id="motivo" placeholder="Motivo de la baja" style="flex:1;min-width:200px"><button class="btn peligro" onclick="darBaja(${a.id})">Dar de baja</button>`;
  if(a.estado==='baja') acciones = `<span style="color:var(--muted);font-size:14px">Baja el ${fmtFecha(a.fechaBaja)}: ${esc(a.motivoBaja)}</span><button class="btn" onclick="matricular(${a.id})">Reactivar</button>`;
  document.getElementById('ficha').innerHTML = `
    <div class="ficha-cab"><h2>${esc(a.nombre)}</h2><span class="chip e-${a.estado}">${a.estado}</span>
      ${waLink(a, `Hola ${nombrePila(a)}, te escribimos de Trilingua. `)}
      <button class="btn sec" onclick="cerrarFicha()">Cerrar</button></div>
    <div style="color:var(--muted);font-size:13px;margin-bottom:14px">${a.alta?'Alumno desde '+fmtFecha(a.alta)+' · ':''}${deuda?'<b style="color:var(--bad)">Debe '+eur(deuda)+'</b>':'Sin recibos pendientes'}</div>
    ${camposAlumno(a,'f-')}
    <div class="fila-acc"><button class="btn" onclick="guardarFicha(${a.id})">Guardar cambios</button>${acciones}</div>

    <div class="seccion"><h3>Pagos</h3>
      ${pagos.length?`<table><thead><tr><th>Mes</th><th>Importe</th><th>Estado</th><th></th></tr></thead><tbody>
      ${pagos.map(p=>`<tr style="cursor:default"><td>${fmtMes(p.mes)}</td><td>${eur(p.importe)}</td>
        <td><span class="chip ${p.estado==='pagado'?'e-activo':'c-Cobro'}">${p.estado}</span></td>
        <td>${p.estado==='pendiente'?`<button class="btn" onclick="marcarPagado(${p.id})">Marcar cobrado</button>`:''}</td></tr>`).join('')}
      </tbody></table>`:'<div class="vacio">Sin pagos registrados.</div>'}
    </div>

    <div class="seccion"><h3>Historial de contactos y visitas</h3>
      <div class="filtros">
        <select id="c-tipo">${TIPOS_CONTACTO.map(t=>`<option>${t}</option>`).join('')}</select>
        <input id="c-fecha" type="date" value="${hoyISO}" style="flex:0">
        <input id="c-nota" placeholder="Qué se ha hablado o hecho">
        <button class="btn" onclick="anadirContacto(${a.id})">Añadir</button>
      </div>
      ${cs.length?`<ul class="hist">${cs.map(c=>`<li><span class="f">${fmtFecha(c.fecha)}</span><span class="t">${c.tipo}</span><span>${esc(c.nota)}</span></li>`).join('')}</ul>`:'<div class="vacio">Sin contactos.</div>'}
    </div>`;
}

function refrescar(){ guardar(); render(); if(ui.fichaId) pintarFicha(); }

function guardarFicha(id){
  const d = leerCampos('f-'); if(!d.nombre){ aviso('Falta el nombre'); return; }
  Object.assign(alumno(id), d); refrescar(); aviso('Cambios guardados');
}
function marcarPagado(pid){
  const p = db.pagos.find(x=>x.id===pid); if(!p) return;
  p.estado='pagado'; refrescar(); aviso('Recibo marcado como cobrado');
}
function completarTarea(tid, aid){
  db.hechas.push(tid);
  const t = tid.split('-')[0];
  const nota = {prueba:'Llamada de seguimiento tras la clase de prueba', faltas:'Llamada por faltas seguidas', examen:'Confirmada inscripción al examen'}[t] || 'Tarea completada';
  db.contactos.push({id:db.seq++, alumnoId:aid, fecha:hoyISO, tipo:'Llamada', nota});
  refrescar(); aviso('Tarea completada y anotada en el historial');
}
function anadirContacto(id){
  const tipo = document.getElementById('c-tipo').value, fecha = document.getElementById('c-fecha').value || hoyISO, nota = document.getElementById('c-nota').value.trim();
  db.contactos.push({id:db.seq++, alumnoId:id, fecha, tipo, nota: nota || tipo});
  refrescar(); aviso('Contacto añadido');
}
function matricular(id){
  const a = alumno(id);
  a.estado='activo'; a.alta=hoyISO; a.fechaBaja=''; a.motivoBaja=''; a.faltas=0;
  if(!db.pagos.some(p=>p.alumnoId===id && p.mes===mesKey(0))) db.pagos.push({id:db.seq++, alumnoId:id, mes:mesKey(0), importe:a.cuota, estado:'pendiente'});
  db.contactos.push({id:db.seq++, alumnoId:id, fecha:hoyISO, tipo:'Visita', nota:'Se matricula en '+a.idioma+' '+a.nivel});
  refrescar(); aviso(a.nombre+' matriculado');
}
function marcarPerdido(id){
  const a = alumno(id), motivo = document.getElementById('motivo').value.trim() || 'Sin motivo indicado';
  a.estado='perdido'; a.fechaBaja=hoyISO; a.motivoBaja=motivo;
  db.contactos.push({id:db.seq++, alumnoId:id, fecha:hoyISO, tipo:'Llamada', nota:'No se matricula. Motivo: '+motivo});
  refrescar(); aviso('Marcado como perdido');
}
function recuperar(id){
  const a = alumno(id); a.estado='interesado'; a.fechaBaja=''; a.motivoBaja='';
  db.contactos.push({id:db.seq++, alumnoId:id, fecha:hoyISO, tipo:'Llamada', nota:'Vuelve a interesarse'});
  refrescar(); aviso('Vuelve a interesado');
}
function darBaja(id){
  const a = alumno(id), motivo = document.getElementById('motivo').value.trim() || 'Sin motivo indicado';
  a.estado='baja'; a.fechaBaja=hoyISO; a.motivoBaja=motivo;
  db.contactos.push({id:db.seq++, alumnoId:id, fecha:hoyISO, tipo:'Llamada', nota:'Baja. Motivo: '+motivo});
  refrescar(); aviso('Baja registrada');
}

document.getElementById('hoy').textContent = HOY.toLocaleDateString('es-ES',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
render();
</script>
</body>
</html>
