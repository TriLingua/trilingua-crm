  <div class="origen">${filas.map(f=>`<div class="fila">
    <div class="cab"><b>${f.o}</b><span>${f.matric} de ${f.total} (${f.total?Math.round(f.matric/f.total*100):0} %) · ${eur(f.ingresos)}/mes</span></div>
    <div class="doble"><span class="l" style="width:${f.total/max*100}%"></span><span class="m" style="width:${f.matric/max*100}%"></span></div>
