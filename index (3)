  input,select,textarea{font:inherit;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:#fff;color:var(--ink)}
  .filtros input{flex:1;min-width:220px}
  table{width:100%;border-collapse:collapse;background:var(--card)}
  th,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--line);font-size:14px}
  th{font-size:12px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.03em}
  tbody tr{cursor:pointer}
  tbody tr:hover{background:#faf9f6}
  .tabla-wrap{border:1px solid var(--line);border-radius:12px;overflow:auto}
  .vacio{color:var(--muted);padding:12px 0;font-size:14px}
  .mini{display:flex;align-items:flex-end;gap:14px;height:120px;margin-top:10px}
  .mini div{flex:1;text-align:center;font-size:12px;color:var(--muted)}
  .mini .col{background:var(--accent);border-radius:6px 6px 0 0;margin:0 auto 6px;width:60%}
