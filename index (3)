  const db = {version:VERSION_DATOS, seq:1, alumnos:[], pagos:[], contactos:[], hechas:[]};
  const nid = () => db.seq++;
  SEMILLA.forEach((r,i) => {
    const [nombre,telefono,idioma,nivel,modalidad,horario,cuota,estado,objetivo,origen,altaOff,faltas,examen,extra] = r;
    const a = {id:nid(), nombre, telefono, email:emailDe(nombre), idioma, nivel, modalidad, horario, cuota, estado, objetivo, origen,
      alta: altaOff!=null ? dia(altaOff) : '', faltas, examen: examen ? {nombre:examen[0], fecha:dia(examen[1])} : {nombre:'',fecha:''},
      fechaBaja: extra && extra.baja!=null ? dia(extra.baja) : '', motivoBaja: extra && extra.motivo || '', notas:''};
    db.alumnos.push(a);
    const c = (off,tipo,nota) => db.contactos.push({id:nid(), alumnoId:a.id, fecha:dia(off), tipo, nota});

    if(estado==='perdido'){
      const fin = (extra.prueba!=null ? extra.prueba : extra.contacto) + 4;
      a.fechaBaja = dia(fin); a.motivoBaja = extra.motivo;
      c(extra.contacto, origen==='Web'?'Email':'WhatsApp', 'Pide información desde '+origen);
      if(extra.prueba!=null) c(extra.prueba, 'Clase de prueba', 'Asiste a la clase de prueba de '+idioma+' '+nivel);
      c(fin, 'Llamada', 'No se matricula. Motivo: '+extra.motivo);
      return;
    }
    if(estado==='interesado'){
      c(extra.prueba-6, origen==='Web'?'Email':'WhatsApp', 'Pide información desde '+origen+'. Se agenda clase de prueba');
      c(extra.prueba, 'Clase de prueba', extra.prueba<=0 ? 'Asiste a la clase de prueba de '+idioma+' '+nivel : 'Clase de prueba programada');
      return;
    }
    // Alumnos matriculados (activos o ya dados de baja)
    if(altaOff >= -100) c(altaOff-7, 'Clase de prueba', 'Clase de prueba antes de matricularse');
    c(altaOff, 'Prueba de nivel', 'Prueba de nivel: entra en '+nivel);
    if(estado==='activo') c(-((i*7)%40)-3, 'WhatsApp', 'Recordatorio de horario y material del mes');
    if(estado==='baja') c(extra.baja, 'Llamada', 'Comunica la baja. Motivo: '+extra.motivo);

    // Pagos de los últimos 3 meses
    const limite = estado==='baja' ? aFecha(dia(extra.baja)) : null;
    for(let m=-2; m<=0; m++){
      const k = mesKey(m);
      const inicioMes = aFecha(k+'-01');
      const finMes = new Date(inicioMes.getFullYear(), inicioMes.getMonth()+1, 0);
      if(aFecha(a.alta) > finMes) continue;
      if(limite && limite < inicioMes) continue;
      const pend = (IMPAGOS[nombre]||[]).includes(m);
      db.pagos.push({id:nid(), alumnoId:a.id, mes:k, importe:cuota, estado: pend?'pendiente':'pagado'});
    }
  });
  const andres = db.alumnos.find(a=>a.nombre==='Andrés Navarro Gil');
  db.contactos.push({id:nid(), alumnoId:andres.id, fecha:dia(-10), tipo:'Email', nota:'Aviso de recibo devuelto del mes anterior'});
  return db;
}

