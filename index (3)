  .hist .f{color:var(--muted);width:96px;flex-shrink:0}
  .hist .t{font-weight:600;width:120px;flex-shrink:0}
  .aviso{font-size:12px;color:var(--muted);text-align:center;padding:20px}
  .toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 16px;border-radius:8px;font-size:14px;opacity:0;transition:opacity .2s;pointer-events:none;z-index:20}
