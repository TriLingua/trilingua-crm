const PLAZAS_GRUPO = 8;
function vistaGrupos(){
  const mapa = {};
  db.alumnos.filter(a=>a.modalidad==='Grupo' && (a.estado==='activo'||a.estado==='interesado')).forEach(a=>{
    const k = a.idioma+'|'+a.nivel+'|'+a.horario;
    (mapa[k] = mapa[k] || {idioma:a.idioma, nivel:a.nivel, horario:a.horario, cuota:a.cuota, activos:[], interesados:[]});
    (a.estado==='activo' ? mapa[k].activos : mapa[k].interesados).push(a);
  });
  const grupos = Object.values(mapa).sort((x,y)=>IDIOMAS.indexOf(x.idioma)-IDIOMAS.indexOf(y.idioma) || x.nivel.localeCompare(y.nivel));
  const ocupadas = grupos.reduce((s,g)=>s+g.activos.length,0), totales = grupos.length*PLAZAS_GRUPO;
  const ingresos = grupos.reduce((s,g)=>s+g.activos.reduce((x,a)=>x+a.cuota,0),0);
  const potencial = grupos.reduce((s,g)=>s+(PLAZAS_GRUPO-g.activos.length)*g.cuota,0);
  const indiv = db.alumnos.filter(a=>a.modalidad!=='Grupo' && a.estado==='activo').sort((a,b)=>a.idioma.localeCompare(b.idioma));
  const chip = a => `<span class="${a.estado==='interesado'?'int':''}" onclick="abrirFicha(${a.id})">${esc(a.nombre.split(' ').slice(0,2).join(' '))}${a.estado==='interesado'?' (interesado)':''}</span>`;
  return `
  <div class="kpis">
    <div class="card kpi"><div class="etq">Grupos abiertos</div><div class="valor">${grupos.length}</div><div class="det">Máximo ${PLAZAS_GRUPO} alumnos por grupo</div></div>
    <div class="card kpi"><div class="etq">Ocupación de los grupos</div><div class="valor">${totales?Math.round(ocupadas/totales*100):0} %</div><div class="det">${ocupadas} de ${totales} plazas ocupadas</div></div>
    <div class="card kpi"><div class="etq">Ingresos de grupos</div><div class="valor">${eur(ingresos)}</div><div class="det">al mes con la ocupación actual</div></div>
    <div class="card kpi"><div class="etq">Si se llenan las plazas libres</div><div class="valor">+${eur(potencial)}</div><div class="det">al mes más (${totales-ocupadas} plazas libres)</div></div>
  </div>
  <h2>Grupos</h2>
  <div class="grupos">${grupos.map(g=>{
    const n=g.activos.length, pct=Math.round(n/PLAZAS_GRUPO*100), clase = pct>=75?'lleno':pct>=40?'medio':'bajo';
    return `<div class="card grupo">
      <h3 class="i-${g.idioma}">${bandera(g.idioma)}${g.idioma} ${g.nivel}</h3><div class="hor">${esc(g.horario)} · ${eur(g.cuota)}/mes</div>
      <div class="ocup"><span>${n} de ${PLAZAS_GRUPO} plazas</span><b>${eur(n*g.cuota)}/mes</b></div>
      <div class="barra ${clase}"><span style="width:${pct}%"></span></div>
      <div class="ocup" style="color:var(--muted)"><span>${PLAZAS_GRUPO-n} ${PLAZAS_GRUPO-n===1?'plaza libre':'plazas libres'}</span><span>+${eur((PLAZAS_GRUPO-n)*g.cuota)} posibles</span></div>
      <div class="nombres">${g.activos.map(chip).join('')}${g.interesados.map(chip).join('')}</div>
    </div>`;}).join('')}</div>
  <h2 style="margin-top:24px">Clases particulares y online (${indiv.length})</h2>
  <div class="tabla-wrap"><table><thead><tr><th>Alumno</th><th>Idioma</th><th>Modalidad · horario</th><th>Cuota</th></tr></thead>
  <tbody>${indiv.map(a=>`<tr onclick="abrirFicha(${a.id})"><td><b>${esc(a.nombre)}</b></td><td class="i-${a.idioma}">${bandera(a.idioma)}${a.idioma} ${a.nivel}</td><td>${a.modalidad} · ${esc(a.horario)}</td><td>${eur(a.cuota)}</td></tr>`).join('')}</tbody></table></div>`;
}

