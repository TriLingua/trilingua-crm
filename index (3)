  .origen .doble .m{position:absolute;left:0;top:0;bottom:0;background:var(--accent)}
  .leyenda{display:flex;gap:14px;font-size:12px;color:var(--muted);margin-bottom:12px}
  .leyenda i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:4px;vertical-align:-1px}
