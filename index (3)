  .grid .ancho{grid-column:1/-1}
  .seccion{margin-top:22px;padding-top:16px;border-top:1px solid var(--line)}
  .fila-acc{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:14px}
  .hist{list-style:none;padding:0;margin:0}
